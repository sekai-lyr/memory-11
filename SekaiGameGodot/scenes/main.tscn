layout_mode = 2
scroll_active = true

[connection signal="item_selected" from="Margin/Root/HandList" to="." method="_on_hand_selected"]
[connection signal="pressed" from="Margin/Root/Actions/Summon" to="." method="_on_summon_pressed"]
[connection signal="pressed" from="Margin/Root/Actions/Activate" to="." method="_on_activate_pressed"]
